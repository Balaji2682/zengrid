{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@zengrid/angular",
  "sourceRoot": "packages/angular/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/angular"],
      "options": {
        "command": "ng-packagr -p packages/angular/ng-package.json -c packages/angular/tsconfig.lib.prod.json"
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["build"],
      "options": {
        "packageRoot": "dist/angular"
      }
    }
  }
}
